// Zed counterpart of .helix/.
//
// Zed has no per-project way to *define* a language server; settings can only reconfigure
// servers that an extension provides. So this relies on:
//   - the "Lean 4" extension (owlx56) for the Lean language and its `lake serve` server
//   - the "Snippets" extension, which registers simple-completion-language-server as "scls"
{
  "lsp": {
    "scls": {
      "binary": {
        "path": "simple-completion-language-server"
      },
      "initialization_options": {
        "feature_words": false,
        "feature_snippets": false,
        "feature_unicode_input": true,
        "case_sensitive": true // \N (ℕ) vs \n
      }
    }
  },
  "languages": {
    // Language name from the extension: languages = ["Lean 4"].
    "Lean 4": {
      // "..." keeps the extension's own Lean server (lean4-lsp).
      "language_servers": ["scls", "..."],
      // Helix needs completion-trigger-len = 1 for short abbreviations; Zed's equivalent:
      "show_completions_on_input": true
    }
  }
}
