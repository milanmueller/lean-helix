// Draft: Zed counterpart of .helix/. UNVERIFIED — see "Check these" in the notes below.
//
// Zed has no per-project way to *define* a language server; settings can only reconfigure
// servers that an extension provides. So this relies on:
//   - the "Lean 4" extension (owlx56) for the Lean language + its server entry
//   - the "Snippets" extension, which registers simple-completion-language-server as "scls"
//
// Unlike Helix, Zed sends textDocument/documentHighlight on every cursor move (75 ms debounce),
// and lean-prism hooks that request, so no key-chaining workaround is needed.
{
  "lsp": {
    // Server id from the Lean 4 extension (owlx56): [language_servers.lean4-lsp].
    "lean4-lsp": {
      "binary": {
        "path": "lean-prism",
        "arguments": ["serve"]
      }
    },
    "scls": {
      "binary": {
        "path": "simple-completion-language-server"
      },
      "initialization_options": {
        "feature_words": false,
        "feature_snippets": false,
        "feature_unicode_input": true,
        "case_sensitive": true // \N (ℕ) vs \n
      }
    }
  },
  "languages": {
    // Language name from the extension: languages = ["Lean 4"].
    "Lean 4": {
      // "..." keeps any other default servers; drop it if lean4-lsp ends up doubled.
      "language_servers": ["lean4-lsp", "scls", "..."],
      // Helix needs completion-trigger-len = 1 for short abbreviations; Zed's equivalent:
      "show_completions_on_input": true
    }
  }
}
